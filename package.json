{
  "name": "hours",
  "productName": "Hours",
  "version": "2.0.0",
  "description": "A calm, accurate, local-first screen time tracker for Windows.",
  "main": "./out/main/index.js",
  "author": "Hours",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-rebuild -f --only better-sqlite3",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "icons": "node scripts/make-icons.cjs",
    "preview": "electron-vite preview",
    "dist": "npm run icons && npm run build && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "koffi": "^2.9.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.hours.desktop",
    "productName": "Hours",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["out/**/*", "package.json"],
    "extraResources": [{ "from": "build/tray.png", "to": "tray.png" }],
    "asarUnpack": ["node_modules/better-sqlite3/**", "node_modules/koffi/**"],
    "npmRebuild": false,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hours",
      "deleteAppDataOnUninstall": false
    }
  }
}
